{
  "name": "learnit",
  "version": "0.1.0-1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mearleycf/learnit"
  },
  "license": "UNLICENSED",
  "author": {
    "name": "Mike Earley",
    "email": "mwe@sent.com",
    "url": "https://github.com/mearleycf"
  },
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "yarn pyodide:copy && yarn react:build && astro check && astro build",
    "build:release": "yarn build && yarn sentry:sourcemaps",
    "check": "astro check",
    "create-sentry-release": "sentry-cli releases new $npm_package_version && sentry-cli releases set-commits $npm_package_version --auto",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "yarn pyodide:copy && yarn react:build && astro dev",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "preview": "astro preview",
    "pyodide:copy": "node scripts/copy-pyodide.mjs",
    "react:build": "node scripts/build-react.mjs",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org five-star-code --project learnit ./dist/ && sentry-cli sourcemaps upload --org five-star-code --project learnit ./dist/",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "version": "yarn create-sentry-release && git push --follow-tags"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/node": "^11.1.6",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/lilita-one": "^5.1.0",
    "@fontsource/mononoki": "^5.1.0",
    "@fontsource/righteous": "^5.1.0",
    "@libsql/client": "^0.18.0",
    "@sentry/astro": "^10.75.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "astro-icon": "^1.2.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "pyodide": "^314.0.7",
    "rehype-sanitize": "^6.0.0",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "ulidx": "^2.4.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.14",
    "@emnapi/runtime": "^1.11.3",
    "@iconify-json/simple-icons": "^1.2.97",
    "@iconify-json/solar": "^1.2.12",
    "@playwright/test": "^1.63.0",
    "@sentry/cli": "^3.8.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^5.0.1"
  },
  "packageManager": "yarn@4.5.1"
}
