{
  "name": "learnit",
  "version": "0.1.0-1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mearleycf/learnit"
  },
  "license": "UNLICENSED",
  "author": {
    "name": "Mike Earley",
    "email": "mwe@sent.com",
    "url": "https://github.com/mearleycf"
  },
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "build:release": "yarn build && yarn sentry:sourcemaps",
    "check": "astro check",
    "create-sentry-release": "sentry-cli releases new $npm_package_version && sentry-cli releases set-commits $npm_package_version --auto",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "astro preview",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org five-star-code --project learnit ./.vercel/output/ && sentry-cli sourcemaps upload --org five-star-code --project learnit ./.vercel/output/",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "version": "yarn create-sentry-release && git push --follow-tags"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/lilita-one": "^5.1.0",
    "@fontsource/mononoki": "^5.1.0",
    "@fontsource/righteous": "^5.1.0",
    "@libsql/client": "^0.18.0",
    "@sentry/astro": "^10.75.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "astro-icon": "^1.2.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "ulidx": "^2.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@iconify-json/simple-icons": "^1.2.97",
    "@iconify-json/solar": "^1.2.12",
    "@playwright/test": "^1.63.0",
    "@sentry/cli": "^3.8.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.13",
    "vitest": "^5.0.1"
  },
  "packageManager": "yarn@4.5.1"
}
