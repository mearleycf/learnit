---
import type { TestCase } from '@lib/exercise-runner/types'

export type WorkspaceFile = {
  filename: string
  language: string
  content: string
  isReadOnly: boolean
  isHidden: boolean
}

interface Props {
  exerciseId: string
  files: WorkspaceFile[]
  entry: string
  tests: TestCase[]
  solution: string | null
  solutionExplanation: string | null
}

const { exerciseId, files, entry, tests, solution, solutionExplanation } = Astro.props

/** Hidden files are linked at run time but never shown, so they get no tab. */
const visible = files.filter(file => !file.isHidden)

/**
 * The tab to open on.
 *
 * The entry file is the one the student edits, so it opens first even when a
 * read-only helper is listed before it.
 */
const initial = visible.find(file => file.filename === entry) ?? visible[0]
---

<section
  class="exercise-workspace"
  data-exercise-id={exerciseId}
  data-entry={entry}
  data-tests={JSON.stringify(tests)}
  data-files={JSON.stringify(files)}
>
  <div class="flex flex-wrap items-center gap-2">
    {
      visible.map(file => (
        <button
          type="button"
          data-role="tab"
          data-filename={file.filename}
          class:list={[
            'rounded px-3 py-1 font-mono text-xs transition',
            file.filename === initial?.filename
              ? 'bg-(--color-raised) font-medium'
              : 'text-(--color-muted) hover:bg-(--color-raised)',
          ]}
        >
          {file.filename}
          {file.isReadOnly && <span class="text-(--color-faint)"> (read only)</span>}
        </button>
      ))
    }
    <p class="text-(--color-faint) ml-auto text-xs" data-role="attempts"></p>
  </div>

  <textarea
    data-role="editor"
    spellcheck="false"
    rows="16"
    class="bg-night-raised text-parchment mt-2 w-full rounded-lg p-4 font-mono text-sm leading-relaxed focus:outline-none disabled:opacity-70"
  ></textarea>

  <div class="mt-3 flex flex-wrap items-center gap-3">
    <button
      type="button"
      data-role="run"
      class="border-teal text-teal hover:bg-teal/10 rounded-lg border px-4 py-2 text-sm transition disabled:opacity-50"
    >
      Run checks
    </button>
    <button type="button" data-role="reset" class="text-(--color-faint) text-sm hover:underline">
      Reset to starter
    </button>
    <p class="text-sm" data-role="summary"></p>
  </div>

  <ul class="mt-4 space-y-2" data-role="results"></ul>

  {
    solution && (
      <details class="mt-4 rounded-lg border border-(--color-edge) p-4">
        <summary class="text-(--color-muted) cursor-pointer text-sm">Show a worked solution</summary>
        <pre class="bg-night-raised text-parchment mt-3 overflow-x-auto rounded-lg p-4 text-sm"><code>{solution}</code></pre>
        {solutionExplanation && <p class="text-(--color-muted) mt-3 text-sm leading-relaxed">{solutionExplanation}</p>}
      </details>
    )
  }
</section>

<script>
  import { runExercise } from '@lib/exercise-runner/client'
  import type { TestCase } from '@lib/exercise-runner/types'

  type WorkspaceFile = {
    filename: string
    language: string
    content: string
    isReadOnly: boolean
    isHidden: boolean
  }

  const workspace = document.querySelector<HTMLElement>('.exercise-workspace')
  if (workspace) {
    const editor = workspace.querySelector<HTMLTextAreaElement>('[data-role="editor"]')!
    const runButton = workspace.querySelector<HTMLButtonElement>('[data-role="run"]')!
    const resetButton = workspace.querySelector<HTMLButtonElement>('[data-role="reset"]')!
    const results = workspace.querySelector<HTMLUListElement>('[data-role="results"]')!
    const summary = workspace.querySelector<HTMLElement>('[data-role="summary"]')!
    const attemptsLabel = workspace.querySelector<HTMLElement>('[data-role="attempts"]')!
    const tabs = [...workspace.querySelectorAll<HTMLButtonElement>('[data-role="tab"]')]

    const exerciseId = workspace.dataset.exerciseId!
    const entry = workspace.dataset.entry!
    const tests: TestCase[] = JSON.parse(workspace.dataset.tests ?? '[]')
    const starters: WorkspaceFile[] = JSON.parse(workspace.dataset.files ?? '[]')

    /** Working copy, keyed by filename. Read-only and hidden files stay at their starter. */
    const draft = new Map(starters.map(file => [file.filename, file.content]))
    const byName = new Map(starters.map(file => [file.filename, file]))
    const storageKey = `learnit:exercise:${exerciseId}`

    // Drafts are a per-browser convenience, so localStorage is the right home.
    const load = () => {
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) ?? 'null') as Record<string, string> | null
        if (!saved) return
        for (const [filename, content] of Object.entries(saved)) {
          if (byName.get(filename)?.isReadOnly === false) draft.set(filename, content)
        }
      } catch {
        // Private mode, blocked storage, or stale shape: the starter is a fine fallback.
      }
    }

    const persist = () => {
      try {
        localStorage.setItem(storageKey, JSON.stringify(Object.fromEntries(draft)))
      } catch {
        // Nothing to do; a run still works without a saved draft.
      }
    }

    // Open on the file the student edits, not on a read-only helper listed first.
    let active = tabs.some(tab => tab.dataset.filename === entry) ? entry : (tabs[0]?.dataset.filename ?? entry)

    const show = (filename: string) => {
      active = filename
      const file = byName.get(filename)
      editor.value = draft.get(filename) ?? ''
      editor.disabled = file?.isReadOnly ?? false
      for (const tab of tabs) {
        const on = tab.dataset.filename === filename
        tab.classList.toggle('bg-(--color-raised)', on)
        tab.classList.toggle('font-medium', on)
        tab.classList.toggle('text-(--color-muted)', !on)
      }
    }

    for (const tab of tabs) {
      tab.addEventListener('click', () => show(tab.dataset.filename!))
    }

    editor.addEventListener('input', () => {
      if (editor.disabled) return
      draft.set(active, editor.value)
      persist()
    })

    resetButton.addEventListener('click', () => {
      for (const file of starters) draft.set(file.filename, file.content)
      persist()
      show(active)
      results.replaceChildren()
      summary.textContent = ''
    })

    runButton.addEventListener('click', async () => {
      runButton.disabled = true
      summary.textContent = 'Running…'
      summary.className = 'text-(--color-muted) text-sm'
      results.replaceChildren()

      const files = starters.map(file => ({ filename: file.filename, content: draft.get(file.filename) ?? '' }))
      const result = await runExercise(files, entry, tests)

      results.replaceChildren(
        ...result.outcomes.map(outcome => {
          const li = document.createElement('li')
          li.className = `rounded-lg border p-3 text-sm ${outcome.passed ? 'border-teal/40' : 'border-rose/50'}`

          const head = document.createElement('p')
          head.className = outcome.passed ? 'text-teal' : 'text-rose'
          head.textContent = `${outcome.passed ? '✓' : '✗'} ${outcome.name}`
          li.append(head)

          const detail = document.createElement('p')
          detail.className = 'text-(--color-muted) mt-1 text-xs'
          detail.textContent = outcome.message ?? outcome.description
          li.append(detail)

          return li
        }),
      )

      const allPassed = result.total > 0 && result.passed === result.total
      summary.textContent = result.loadError ? result.loadError : `${result.passed} of ${result.total} checks passing`
      summary.className = `text-sm ${allPassed ? 'text-teal' : result.loadError ? 'text-rose' : 'text-(--color-muted)'}`

      try {
        const response = await fetch('/api/exercise-attempt', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ exerciseId, passed: result.passed, total: result.total }),
        })
        if (response.ok) {
          const data = (await response.json()) as { attempts: number; score: number; completed: boolean }
          attemptsLabel.textContent =
            `${data.attempts} attempt${data.attempts === 1 ? '' : 's'} · best ${data.score}%` +
            (data.completed ? ' · passed' : '')
        }
      } catch {
        // Recording an attempt is bookkeeping; a failure must not hide the results.
      }

      runButton.disabled = false
    })

    load()
    show(active)
  }
</script>
