---
import '@fontsource-variable/inter'
import '@styles/global.css'

interface Props {
  title: string
}

const { title } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="font-sans">
    <a
      href="#main"
      class="bg-(--color-raised) text-(--color-ink) focus:ring-(--color-link) sr-only rounded px-4 py-2 focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:ring-2"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
