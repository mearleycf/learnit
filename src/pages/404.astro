---
import Layout from '@layouts/Layout.astro'
---

<Layout title="Not found">
  <main class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="font-display text-4xl">Not found</h1>
    <p class="mt-3 text-(--color-muted)">That page does not exist.</p>
    <a href="/" class="text-(--color-link) mt-6 inline-block text-sm hover:underline">&larr; All courses</a>
  </main>
</Layout>
