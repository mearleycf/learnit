---
import { actions } from 'astro:actions'

import { createMarkdownProcessor } from '@astrojs/markdown-remark'

import Layout from '@layouts/Layout.astro'
import { CATEGORY_LABELS, FEEDBACK_CATEGORIES } from '@schemas/feedback.schema'
import {
  flattenSections,
  getCourseBySlug,
  getCourseOutline,
  getExerciseForSection,
  getSection,
  parseSectionContent,
  sectionHref,
} from '@utils/courses'
import { listNotes } from '@utils/notes'
import { completedSet, getCurrentUser, getProgress } from '@utils/progress'

const { slug, chapter: chapterParam, section: sectionParam } = Astro.params
const chapterNumber = Number(chapterParam)
const sectionNumber = Number(sectionParam)
const course = slug ? await getCourseBySlug(slug) : null
const section =
  course && Number.isInteger(chapterNumber) && Number.isInteger(sectionNumber)
    ? await getSection(course.id, chapterNumber, sectionNumber)
    : null

if (!course || !section) {
  return Astro.rewrite('/404')
}

const result = Astro.getActionResult(actions.toggleSectionComplete)

const user = await getCurrentUser()
const progress = user ? await getProgress(user.id, course.id) : null
const isComplete = result?.data ? result.data.complete : completedSet(progress).has(section.id)

const notes = user ? await listNotes(user.id, section.id) : []
const noteError = Astro.getActionResult(actions.addNote)?.error
const reported = Astro.getActionResult(actions.reportFeedback)?.data?.reported ?? false

const outline = await getCourseOutline(course.id)
const ordered = flattenSections(outline)
const index = ordered.findIndex(row => row.id === section.id)
const previous = index > 0 ? ordered[index - 1] : undefined
const next = index >= 0 && index < ordered.length - 1 ? ordered[index + 1] : undefined

const content = parseSectionContent(section.content)
const exercise = section.content_type === 'exercise' ? await getExerciseForSection(section.id) : null

const processor = await createMarkdownProcessor({})
const lessonHtml =
  content?.content_type === 'lesson' && content.lesson ? (await processor.render(content.lesson.markdown)).code : null
const recap = content?.content_type === 'recap' ? content.recap : null

type CodeFile = { filename: string; language: string; content: unknown }
const codeFiles = (exercise?.code_files as { files?: CodeFile[] } | null)?.files ?? []
type Hint = { order: number; content: unknown }
const hints = (exercise?.hints as { hints?: Hint[] } | null)?.hints ?? []
type Check = { name: string; description: string }
const checks = (exercise?.tests as { tests?: Check[] } | null)?.tests ?? []
---

<Layout title={`${section.title} — ${course.title}`}>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <a href={`/courses/${course.slug}`} class="text-sm text-(--color-link) hover:underline">&larr; {course.title}</a>

    <p class="mt-4 text-xs uppercase tracking-wide text-(--color-faint)">
      Chapter {chapterNumber}, section {section.section_display_number} &middot; {section.content_type}
    </p>
    <h1 class="font-display mt-1 text-3xl tracking-tight">{section.title}</h1>
    <p class="mt-2 text-(--color-muted)">{section.description}</p>

    {
      lessonHtml && (
        <article
          class="prose-headings:font-semibold prose-pre:bg-night-raised prose-pre:text-parchment mt-8 leading-relaxed [&_code]:rounded [&_code]:bg-(--color-raised) [&_code]:px-1 [&_h2]:mt-8 [&_h2]:text-xl [&_h2]:font-semibold [&_li]:ml-5 [&_li]:list-disc [&_p]:mt-4 [&_pre]:mt-4 [&_pre]:overflow-x-auto [&_pre]:rounded-lg [&_pre]:bg-night-raised [&_pre]:p-4 [&_pre_code]:bg-transparent [&_pre_code]:text-parchment [&_ul]:mt-4"
          set:html={lessonHtml}
        />
      )
    }

    {
      recap && (
        <section class="mt-8">
          <p class="leading-relaxed">{recap.summary}</p>
          <h2 class="mt-6 text-lg font-semibold">Key points</h2>
          <ul class="mt-3 space-y-2">
            {recap.key_points.map(point => (
              <li class="ml-5 list-disc leading-relaxed">{point}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      exercise && (
        <section class="mt-8 space-y-6">
          <div class="border-peach/50 bg-peach/10 rounded-lg border p-5">
            <h2 class="font-semibold">Instructions</h2>
            <pre class="mt-3 whitespace-pre-wrap font-sans text-sm leading-relaxed">{exercise.instructions}</pre>
            <p class="mt-3 text-xs text-(--color-muted)">
              {exercise.difficulty} &middot; about {exercise.estimated_time_minutes} minutes
            </p>
          </div>

          {codeFiles.map(file => (
            <div>
              <p class="text-xs font-medium text-(--color-muted)">
                {file.filename} &middot; {file.language}
              </p>
              <pre class="mt-1 overflow-x-auto rounded-lg bg-night-raised p-4 text-sm text-parchment">
                <code>{String(file.content)}</code>
              </pre>
            </div>
          ))}

          {checks.length > 0 && (
            <div>
              <h2 class="font-semibold">Checks ({checks.length})</h2>
              <ul class="mt-2 space-y-1">
                {checks.map(check => (
                  <li class="text-sm text-(--color-muted)">
                    <span class="font-medium text-(--color-ink)">{check.name}</span> — {check.description}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {hints.length > 0 && (
            <details class="rounded-lg border border-(--color-edge) p-4">
              <summary class="cursor-pointer text-sm font-medium">Hints ({hints.length})</summary>
              <ol class="mt-3 space-y-2">
                {hints.map(hint => (
                  <li class="ml-5 list-decimal text-sm leading-relaxed">{String(hint.content)}</li>
                ))}
              </ol>
            </details>
          )}
        </section>
      )
    }

    {
      !lessonHtml && !recap && !exercise && (
        <p class="mt-8 rounded-lg border border-dashed border-(--color-edge) p-8 text-center text-(--color-muted)">
          This section has no content yet.
        </p>
      )
    }

    {
      progress && (
        <form method="POST" action={actions.toggleSectionComplete} class="mt-10">
          <input type="hidden" name="courseId" value={course.id} />
          <input type="hidden" name="sectionId" value={section.id} />
          <input type="hidden" name="complete" value={isComplete ? 'false' : 'true'} />
          <button
            type="submit"
            class={`rounded-lg border px-4 py-2 text-sm transition ${
              isComplete
                ? 'border-teal text-teal hover:bg-teal/10'
                : 'border-(--color-edge) hover:bg-(--color-raised)'
            }`}
          >
            {isComplete ? '\u2713 Completed — mark as unread' : 'Mark complete'}
          </button>
        </form>
      )
    }

    {
      user && (
        <section class="mt-12 border-t border-(--color-edge) pt-8">
          <h2 class="font-semibold">Notes {notes.length > 0 && <span class="text-(--color-faint)">({notes.length})</span>}</h2>

          <form method="POST" action={actions.addNote} class="mt-4">
            <input type="hidden" name="sectionId" value={section.id} />
            <textarea
              name="markdown"
              rows="3"
              required
              placeholder="What do you want to remember from this section?"
              class="w-full rounded-lg border border-(--color-edge) bg-(--color-raised) p-3 text-sm focus:border-(--color-link) focus:outline-none"
            />
            <input
              type="text"
              name="quote"
              placeholder="Optional: the passage this is about"
              class="mt-2 w-full rounded-lg border border-(--color-edge) bg-(--color-raised) p-3 text-sm focus:border-(--color-link) focus:outline-none"
            />
            {noteError && <p class="text-rose mt-2 text-sm">{noteError.message}</p>}
            <button
              type="submit"
              class="mt-2 rounded-lg border border-(--color-edge) px-4 py-2 text-sm transition hover:bg-(--color-raised)"
            >
              Add note
            </button>
          </form>

          <ul class="mt-6 space-y-4">
            {notes.map(note => (
              <li class="rounded-lg border border-(--color-edge) p-4">
                {note.quote && (
                  <blockquote class="border-sky text-(--color-muted) border-l-2 pl-3 text-sm italic">
                    {note.quote}
                  </blockquote>
                )}
                <p class="mt-2 text-sm leading-relaxed whitespace-pre-wrap">{note.markdown}</p>
                <div class="mt-3 flex items-center justify-between">
                  <time class="text-(--color-faint) text-xs" datetime={note.created_at.toISOString()}>
                    {note.created_at.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </time>
                  <form method="POST" action={actions.removeNote}>
                    <input type="hidden" name="noteId" value={note.id} />
                    <button type="submit" class="text-(--color-faint) hover:text-rose text-xs">
                      Delete
                    </button>
                  </form>
                </div>
              </li>
            ))}
          </ul>

          {notes.length === 0 && <p class="text-(--color-faint) mt-4 text-sm">No notes on this section yet.</p>}
        </section>
      )
    }

    {
      user && (
        <section class="mt-10">
          <details class="rounded-lg border border-(--color-edge) p-4" open={Boolean(noteError) === false && reported}>
            <summary class="text-(--color-muted) cursor-pointer text-sm">Report a problem with this section</summary>

            {reported ? (
              <p class="text-teal mt-3 text-sm">Thanks. Logged in <a href="/feedback" class="underline">feedback</a>.</p>
            ) : (
              <form method="POST" action={actions.reportFeedback} class="mt-3 space-y-2">
                <input type="hidden" name="sectionId" value={section.id} />
                <select
                  name="category"
                  required
                  aria-label="Problem category"
                  class="w-full rounded-lg border border-(--color-edge) bg-(--color-raised) p-2 text-sm"
                >
                  {FEEDBACK_CATEGORIES.map(category => (
                    <option value={category}>{CATEGORY_LABELS[category]}</option>
                  ))}
                </select>
                <textarea
                  name="markdown"
                  rows="3"
                  required
                  placeholder="What is wrong?"
                  class="w-full rounded-lg border border-(--color-edge) bg-(--color-raised) p-3 text-sm focus:border-(--color-link) focus:outline-none"
                />
                <button
                  type="submit"
                  class="rounded-lg border border-(--color-edge) px-4 py-2 text-sm transition hover:bg-(--color-raised)"
                >
                  Send report
                </button>
              </form>
            )}
          </details>
        </section>
      )
    }

    <nav class="mt-12 flex justify-between gap-4 border-t border-(--color-edge) pt-6 text-sm">
      {
        previous ? (
          <a href={sectionHref(course.slug, previous)} class="hover:underline">
            &larr; {previous.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={sectionHref(course.slug, next)} class="text-right hover:underline">
            {next.title} &rarr;
          </a>
        )
      }
    </nav>
  </main>
</Layout>
