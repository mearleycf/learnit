---
import Layout from '@layouts/Layout.astro'
import { listCourses } from '@utils/courses'

const courses = await listCourses()

const formatPrice = (price: number | null) => (price == null || price === 0 ? 'Free' : `$${price.toFixed(2)}`)
---

<Layout title="Courses">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="font-display text-4xl tracking-tight">Courses</h1>
    <p class="mt-2 text-gray-600">{courses.length} available</p>

    <ul class="mt-8 space-y-4">
      {
        courses.map(course => (
          <li class="rounded-lg border border-gray-200 p-5 transition hover:border-gray-400">
            <a href={`/courses/${course.slug}`} class="block">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="text-xl font-semibold">{course.title}</h2>
                <span class="shrink-0 text-sm text-gray-500">{formatPrice(course.price)}</span>
              </div>
              <p class="mt-1 text-gray-600">{course.description}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <span class="rounded bg-gray-100 px-2 py-0.5 text-xs uppercase tracking-wide text-gray-700">
                  {course.level}
                </span>
                {course.tags?.map(tag => (
                  <span class="rounded bg-gray-50 px-2 py-0.5 text-xs text-gray-600">{tag}</span>
                ))}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
