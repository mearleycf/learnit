---
import Layout from '@layouts/Layout.astro'
import { listCourses } from '@utils/courses'

const courses = await listCourses()

const formatPrice = (price: number | null) => (price == null || price === 0 ? 'Free' : `$${price.toFixed(2)}`)
---

<Layout title="Courses">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <div class="flex items-baseline justify-between gap-4">
      <h1 class="font-display text-4xl tracking-tight">Courses</h1>
      <div class="flex gap-4 text-sm">
        <a href="/notes" class="text-(--color-link) hover:underline">Notes</a>
        <a href="/feedback" class="text-(--color-link) hover:underline">Feedback</a>
      </div>
    </div>
    <p class="mt-2 text-(--color-muted)">{courses.length} available</p>

    <ul class="mt-8 space-y-4">
      {
        courses.map(course => (
          <li class="rounded-lg border border-(--color-edge) p-5 transition hover:border-(--color-faint)">
            <a href={`/courses/${course.slug}`} class="block">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="text-xl font-semibold">{course.title}</h2>
                <span class="shrink-0 text-sm text-(--color-muted)">{formatPrice(course.price)}</span>
              </div>
              <p class="mt-1 text-(--color-muted)">{course.description}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <span class="rounded bg-(--color-raised) px-2 py-0.5 text-xs uppercase tracking-wide text-(--color-muted)">
                  {course.level}
                </span>
                {course.tags?.map(tag => (
                  <span class="rounded bg-(--color-raised) px-2 py-0.5 text-xs text-(--color-muted)">{tag}</span>
                ))}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
